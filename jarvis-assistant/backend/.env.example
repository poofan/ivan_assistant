# Application Settings
APP_NAME="Jarvis Assistant"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://jarvis:jarvis_password@db:5432/jarvis_db

# Redis
REDIS_URL=redis://redis:6379/0

# LLM Service
LLM_SERVICE_URL=http://llm-service:8001
LLM_MODEL=qwen2.5-3b

# STT Service
STT_SERVICE_URL=http://stt-service:8002

# TTS Service
TTS_SERVICE_URL=http://tts-service:8003

# Skills Service
SKILLS_SERVICE_URL=http://skills-service:8004

# API Keys (замените на свои)
OPENWEATHER_API_KEY=your_api_key_here
GOOGLE_MAPS_API_KEY=your_api_key_here
