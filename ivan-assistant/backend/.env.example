# Application Settings
APP_NAME="Ivan Assistant"
APP_VERSION="0.1.0"
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://ivan:ivan_password@db:5432/ivan_assistant
REDIS_URL=redis://redis:6379/0

# LLM Settings
LOCAL_LLM_MODEL=qwen2.5-3b
LOCAL_LLM_URL=http://llm-service:8001
CLOUD_LLM_URL=https://api.cloud-llm.com/v1
CLOUD_LLM_API_KEY=your_api_key_here

# STT Service
STT_SERVICE_URL=http://stt-service:8002

# TTS Service
TTS_SERVICE_URL=http://tts-service:8003

# Security
SECRET_KEY=your-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
